# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=                 # or NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY (sb_publishable_...)
SUPABASE_SERVICE_ROLE_KEY=                     # or SUPABASE_SECRET_KEY (sb_secret_...). Server and scripts only.

# Seals each person's AI key (AES-256-GCM). Generate with: openssl rand -base64 32
# Changing it makes saved keys unreadable; people would add their key again.
KEY_ENCRYPTION_SECRET=

# The admin (can invite and revoke people).
ADMIN_EMAIL=daniel@example.com

# Open Food Facts. Staging during development (https://world.openfoodfacts.net, needs basic auth off:off),
# production is https://world.openfoodfacts.org
OFF_BASE_URL=https://world.openfoodfacts.net
OFF_USER_AGENT=Fatty/0.1 (daniel@example.com)

# Where invite emails send people back to. Defaults to the request's origin.
# NEXT_PUBLIC_SITE_URL=https://fatty.vercel.app
