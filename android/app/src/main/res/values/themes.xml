<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- DayNight, so the WebView's prefers-color-scheme follows the system theme. The web app draws
         its own dark theme; algorithmic darkening is off (MainActivity). -->
    <style name="Theme.Fatty" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/system_bar</item>
        <item name="android:colorBackground">@color/page_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
