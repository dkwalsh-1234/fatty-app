<?xml version="1.0" encoding="utf-8"?>
<!-- The Fatty punk (design/icon/fatty-icon-source.jpg), made by scripts/make-icons.mjs: full-bleed
     on its orange, the figure inside every launcher's mask. The monochrome layer, traced from the
     art's outlines, is what launchers tint when themed icons are on. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/icon_bg" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
